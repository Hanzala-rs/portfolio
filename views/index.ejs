<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= profile.name %> — <%= profile.role %></title>
  <meta name="description" content="<%= profile.name %>, <%= profile.role %> in <%= profile.location %>. RAG systems, multi-agent LLMs, voice AI and MLOps.">
  <meta property="og:title" content="<%= profile.name %> — <%= profile.role %>">
  <meta property="og:description" content="RAG systems, multi-agent LLMs, voice AI and MLOps.">
  <meta name="theme-color" content="#050506">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%23050506'/><circle cx='32' cy='32' r='7' fill='white'/></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>">
</head>
<body class="is-intro">

  <!-- ============ NAV ============ -->
  <header class="nav" data-reveal-after-intro>
    <a href="#top" class="nav__brand"><%= profile.name.toUpperCase() %></a>
    <nav class="nav__links" aria-label="Primary">
      <a href="#top" class="is-active">Home</a>
      <a href="#about">About</a>
      <a href="#journey">Journey</a>
      <a href="#work">Projects</a>
      <a href="#services">Services</a>
      <a href="#contact">Contact</a>
    </nav>
    <button class="nav__toggle" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button>
  </header>

  <main id="main">

    <!-- ============ HERO + INTRO ============ -->
    <section class="hero" id="top" aria-label="Intro">
      <canvas class="hero__particles" data-portrait="/assets/portrait.png" aria-hidden="true"></canvas>
      <div class="hero__glow" aria-hidden="true"></div>

      <div class="intro" aria-hidden="true">
        <span class="intro__dot"></span>
        <span class="intro__flick"></span>
      </div>

      <h1 class="hero__word" data-from="<%= profile.firstName.toUpperCase() %>" data-to="PORTFOLIO" aria-label="<%= profile.name %> — Portfolio"></h1>

      <div class="hero__bar" data-reveal-after-intro>
        <p class="hero__role"><strong>AI / ML</strong> <em>Engineer</em></p>
        <p class="hero__now"><span class="pulse"></span><%= profile.current %></p>
        <a href="#contact" class="pill pill--ghost">Contact</a>
      </div>

      <button class="intro__skip" type="button">Skip intro</button>
    </section>

    <!-- ============ ABOUT ============ -->
    <section class="about" id="about">
      <canvas class="swirl" aria-hidden="true"></canvas>
      <div class="about__marquee" aria-hidden="true">
        <div class="marquee">
          <% for (let r = 0; r < 2; r++) { %><span><% profile.marquee.forEach(m => { %><%= m %> · <% }) %></span><% } %>
        </div>
      </div>

      <div class="about__inner container">
        <p class="eyebrow" data-reveal>Machine learning / Independent builder</p>
        <h2 class="display chrome glitch" data-text="AI / ML ENGINEER" data-reveal>AI / ML<br>ENGINEER</h2>
        <p class="about__lead" data-reveal><%= profile.summary %></p>

        <div class="stats">
          <% profile.stats.forEach((s, i) => { %>
          <div class="stat" data-reveal style="--d:<%= i * 90 %>ms">
            <span class="stat__value chrome"><%= s.value %></span>
            <span class="stat__label"><%= s.label %></span>
            <span class="stat__note"><%= s.note %></span>
          </div>
          <% }) %>
        </div>

        <div class="about__actions" data-reveal>
          <a class="pill" href="/resume">Download resume</a>
          <a class="pill pill--ghost" href="<%= profile.links.github %>" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </section>

    <!-- ============ JOURNEY (horizontal) ============ -->
    <section class="journey" id="journey">
      <div class="journey__sticky">
        <div class="journey__track">
          <div class="journey__intro">
            <p class="eyebrow">Experience &amp; education</p>
            <h2 class="display chrome">WHERE<br>I'VE BEEN</h2>
            <p class="muted">The road so far — from data science classes to shipping ML on client servers.</p>
          </div>

          <% profile.experience.forEach((e, i) => { %>
          <article class="job">
            <span class="job__year outline" aria-hidden="true"><%= e.year %></span>
            <div class="job__body">
              <p class="eyebrow"><%= String(i + 1).padStart(2, '0') %> / <%= e.mode %></p>
              <h3 class="job__role"><%= e.role %></h3>
              <p class="job__org"><%= e.org %> <span>· <%= e.period %></span></p>
              <ul>
                <% e.points.forEach(p => { %><li><%= p %></li><% }) %>
              </ul>
            </div>
          </article>
          <% }) %>
        </div>
        <div class="journey__progress" aria-hidden="true"><span></span></div>
      </div>
    </section>

    <!-- ============ WORK (3D carousel) ============ -->
    <section class="work light" id="work">
      <div class="work__head container">
        <p class="eyebrow">From github.com/Hanzala-rs</p>
        <p class="work__hint">Drag, use the arrows, or click a card</p>
      </div>

      <div class="carousel" tabindex="0" aria-label="Featured projects carousel">
        <div class="carousel__stage">
          <div class="carousel__ring">
            <% projects.forEach((p, i) => { %>
            <button class="card art--<%= p.art %>" type="button" data-index="<%= i %>" aria-label="Open <%= p.title %>">
              <span class="card__art"><span class="card__glyph"><%= p.glyph %></span></span>
              <span class="card__meta"><span><%= String(i + 1).padStart(2, '0') %></span><span><%= p.tags %></span></span>
            </button>
            <% }) %>
          </div>
        </div>
      </div>

      <div class="work__caption container">
        <button class="arrow" data-dir="-1" aria-label="Previous project">←</button>
        <div class="work__now" aria-live="polite">
          <h3 class="work__title"><%= projects[0].title %></h3>
          <p class="work__tagline"><%= projects[0].tagline %></p>
        </div>
        <button class="arrow" data-dir="1" aria-label="Next project">→</button>
      </div>

      <div class="work__foot container">
        <h2 class="display display--sm">SELECTED<br>PROJECTS</h2>
        <ul class="also">
          <% profile.alsoBuilt.forEach(a => { %>
          <li><strong><%= a.title %></strong><span><%= a.note %></span></li>
          <% }) %>
        </ul>
      </div>
    </section>

    <!-- ============ CERTS (hex ring) ============ -->
    <section class="certs light" id="certs">
      <div class="container certs__grid">
        <h2 class="display display--sm">CREDENTIALS</h2>
        <div class="hex" aria-hidden="true">
          <div class="hex__scene">
            <span class="hex__center">CERTS ’<%= String(year).slice(2) %></span>
            <% profile.certifications.forEach((c, i) => { %>
            <div class="hex__face" style="--i:<%= i %>">
              <span class="hex__issuer"><%= c.issuer %></span>
              <span class="hex__title"><%= c.title %></span>
              <span class="hex__date"><%= c.date %></span>
            </div>
            <% }) %>
          </div>
        </div>
        <ol class="certs__list">
          <% profile.certifications.forEach(c => { %>
          <li><span><%= c.title %></span><em><%= c.issuer %> · <%= c.date %></em></li>
          <% }) %>
        </ol>
      </div>
    </section>

    <!-- ============ SERVICES ============ -->
    <section class="services light" id="services">
      <div class="container">
        <h2 class="display display--md center" data-reveal>WHAT I BUILD</h2>
        <p class="center muted services__sub" data-reveal>End-to-end AI — from the data pipeline to the model to the server it runs on.</p>
        <div class="accordion">
          <% profile.services.forEach((s, i) => { %>
          <details class="acc" <%= i === 0 ? 'open' : '' %> data-reveal>
            <summary><span class="acc__n"><%= String(i + 1).padStart(2, '0') %></span><span class="acc__t"><%= s.title %></span><span class="acc__i" aria-hidden="true"></span></summary>
            <div class="acc__body">
              <p><%= s.text %></p>
              <ul class="chips"><% s.skills.forEach(k => { %><li><%= k %></li><% }) %></ul>
            </div>
          </details>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- ============ CONTACT ============ -->
    <section class="contact" id="contact">
      <div class="contact__ticker" aria-hidden="true">
        <div class="marquee marquee--fast"><% for (let r = 0; r < 2; r++) { %><span>OPEN TO AI / ML ROLES · RAG · AGENTS · VOICE AI · MLOPS · </span><% } %></div>
      </div>
      <div class="container contact__inner">
        <h2 class="display display--xl chrome" data-reveal>LET'S TALK</h2>
        <a class="contact__mail" href="mailto:<%= profile.email %>" data-reveal><%= profile.email %></a>
        <div class="contact__pills" data-reveal>
          <a class="pill pill--ghost" href="<%= profile.links.github %>" target="_blank" rel="noopener">GitHub</a>
          <a class="pill pill--ghost" href="<%= profile.links.linkedin %>" target="_blank" rel="noopener">LinkedIn</a>          <a class="pill" href="/resume">Resume</a>
        </div>
      </div>
      <footer class="footer container">
        <span>© <%= year %> <%= profile.name %></span>
        <span><%= profile.location %></span>
        <span>Built with Node.js &amp; Express</span>
      </footer>
    </section>
  </main>

  <!-- ============ PROJECT MODAL ============ -->
  <dialog class="modal" aria-labelledby="modal-title">
    <button class="modal__close" type="button" aria-label="Close">✕</button>
    <div class="modal__content"></div>
  </dialog>

  <script>window.__PROJECTS__ = <%- JSON.stringify(projects).replace(/</g, '\\u003c') %>;</script>
  <script src="/js/main.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
